{
  "name": "@sabha/llm",
  "version": "0.1.0",
  "private": true,
  "description": "Provider-agnostic LLM wrapper with Zod-validated structured output",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config ../../vitest.config.ts",
    "smoke": "cd ../.. && vitest run packages/llm/src/smoke.test.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@sabha/ledger": "workspace:*",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.24.6"
  },
  "devDependencies": {
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
