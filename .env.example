# Web
NEXT_PUBLIC_SITE_URL=http://localhost:3000
WAITLIST_WEBHOOK_URL=

# Database. Local: Docker Postgres. Early-access production: Neon (enable pgvector).
DATABASE_URL=postgresql://sabha:sabha@localhost:5432/sabha

# Your own model keys. Every person using Sabha adds theirs in Settings.
# Combined OpenAI + Anthropic spend is hard-stopped before ₹100.
# Do not put these in GitHub Actions — CI stays on mocked tests.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# 32-byte base64. Required on Vercel so saved keys can be encrypted.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SABHA_SECRETS_KEY=
# Optional smoke-test model overrides
# OPENAI_SMOKE_MODEL=openai/gpt-4o-mini
# ANTHROPIC_SMOKE_MODEL=anthropic/claude-3-5-haiku-latest
